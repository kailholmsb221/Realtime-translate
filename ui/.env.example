# Скопируйте в .env.local и правьте под себя. Значения ниже — значения по умолчанию.

# WebSocket движка (события и команды session.start/session.stop).
NEXT_PUBLIC_ENGINE_WS=ws://localhost:8765

# REST движка (история и голоса). Переменная читается на сервере Next.js:
# если движок отвечает — route handlers проксируют его, если нет — отдают mocks/data.json.
ENGINE_HTTP=http://localhost:8766

# Необязательно: заставить браузер ходить в движок напрямую, минуя заглушки Next.js.
# Требует CORS на стороне движка.
# NEXT_PUBLIC_ENGINE_HTTP=http://localhost:8766
