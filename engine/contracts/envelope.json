{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realtime-translator.local/schemas/envelope.json",
  "title": "Envelope",
  "description": "Общий конверт всех сообщений WebSocket (ARCHITECTURE.md раздел 5). Конкретный payload валидируется схемой соответствующего типа.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "ts": {
      "type": "integer",
      "description": "unix-время события в миллисекундах"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "type",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
