{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realtime-translator.local/schemas/tts.chunk.json",
  "title": "TTS chunk",
  "description": "Служебный чанк синтезированного аудио (PCM 24 kHz mono int16, base64). UI не обязателен.",
  "type": "object",
  "properties": {
    "type": {
      "const": "tts.chunk"
    },
    "ts": {
      "type": "integer",
      "description": "unix-время события в миллисекундах"
    },
    "payload": {
      "type": "object",
      "properties": {
        "stream": {
          "type": "string",
          "enum": [
            "in",
            "out"
          ]
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "pcm_base64": {
          "type": "string",
          "contentEncoding": "base64"
        }
      },
      "required": [
        "stream",
        "seq",
        "pcm_base64"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
